# Example configuration for the PermaGraph REST API
# Copy to .env and adjust values as needed

# Required API key for authenticated requests
PERMAGRAPH_API_KEY=your-api-key

# GraphRAG connection
GRAPHRAG_HOST=localhost
GRAPHRAG_PORT=6379

# Optional LLM keys
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXICA_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
