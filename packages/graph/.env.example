# Runtime settings
SERVICE_NAME=permagraph-api
OTEL_EXPORTER_OTLP_ENDPOINT=
ENVIRONMENT=production
MEMGRAPH_CONNECTION_STRING=
GRAPHRAG_CONFIG=
FALKORDB_CONNECTION_STRING=redis://localhost:6379
