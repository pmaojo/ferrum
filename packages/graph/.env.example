TOKEN_BUDGET_STORAGE_PATH=
DEFAULT_MONTHLY_BUDGET_USD=100.0
ALERT_THRESHOLD_PERCENT=80.0
ENABLE_DEGRADATION=true
DEFAULT_COMPRESSION_RATIO=0.7
MIN_TRIPLES=10
USE_EMBEDDINGS=true
LLM_ERROR_THRESHOLD=5
LLM_LATENCY_THRESHOLD_MS=800
