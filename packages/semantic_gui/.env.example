# Database Configuration
# Note: the bundled docker-compose.yml publishes Postgres on 5432. If something
# else already owns that port, run the db service with a different mapping and
# point DATABASE_URL at it, e.g. postgresql://postgres:postgres@localhost:55432/semanticcodegraph
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@localhost:5432/semanticcodegraph?sslmode=disable
DATABASE_HOST=localhost
DATABASE_USER=postgres
DATABASE_PASSWORD=YOUR_DATABASE_PASSWORD
DATABASE_NAME=semanticcodegraph

# Application Configuration
NODE_ENV=development

# The server validates these three at boot and exits if any is missing —
# GROQ_API_KEY included, even for purely visual work. AI endpoints will fail
# until it holds a real key.
GROQ_API_KEY=YOUR_GROQ_API_KEY
SESSION_SECRET=YOUR_SESSION_SECRET
PERMAGRAPH_API_URL=http://localhost:8000

# Networking
# HOST defaults to 0.0.0.0 so containers stay reachable; use 127.0.0.1 for
# loopback-only local development.
# HOST=127.0.0.1
# SO_REUSEPORT is opt-in. Leave it off unless you run clustered workers: macOS
# and Windows reject the socket option and the server would crash at startup.
# REUSE_PORT=true

# Optional integrations
# NOTION_INTEGRATION_SECRET=
# NOTION_PAGE_URL=
# JWT_SECRET=            # defaults to 'test-secret'; set it for real auth
