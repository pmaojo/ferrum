{
  "extends": "./tsconfig.base.json",
  "include": [
    "client/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.tsx",
    "**/__tests__/**",
    "client/src/setupTests.ts",
    "server",
    "client/src/pages/graph-editor-backup.tsx"
  ],
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./client/src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    }
  }
}
