{
  "id": "spring-boot-layered",
  "name": "Spring Boot Layered Architecture",
  "description": "Traditional Spring Boot application with layered architecture",
  "nodeTypes": [
    {
      "type": "controller",
      "pattern": "Controller",
      "color": "#6DB33F",
      "icon": "🎮",
      "description": "REST controller handling HTTP requests"
    },
