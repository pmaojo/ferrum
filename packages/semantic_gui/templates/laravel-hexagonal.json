{
  "id": "laravel-hexagonal",
  "name": "Laravel Hexagonal Architecture",
  "description": "Template for Laravel projects using hexagonal architecture and DDD principles",
  "extends": "base-hexagonal",
  "nodeTypes": [
    {
      "type": "module",
      "pattern": "Module",
      "color": "#3B82F6",
      "icon": "📦",
      "description": "Kthulu module containing use cases, adapters, and entities"
    },
    {
      "type": "usecase",
      "pattern": "UseCase",
      "color": "#10B981",
      "icon": "⚡",
      "description": "Domain use case implementing business logic"
    },
    {
      "type": "adapter",
      "pattern": "Adapter",
      "color": "#F59E0B",
      "icon": "🔌",
      "description": "Infrastructure adapter implementing ports"
    },
    {
      "type": "port",
      "pattern": "Port",
      "color": "#8B5CF6",
      "icon": "🚪",
      "description": "Interface defining contract between domain and infrastructure"
    },
    {
      "type": "entity",
      "pattern": "Entity",
      "color": "#EF4444",
      "icon": "🏛️",
      "description": "Domain entity representing business concepts"
    },
    {
      "type": "event",
      "pattern": "Event",
      "color": "#F97316",
      "icon": "📡",
      "description": "Domain event for decoupled communication"
    },
    {
      "type": "handler",
      "pattern": "Handler",
      "color": "#06B6D4",
      "icon": "🎯",
      "description": "HTTP handler for API endpoints"
    },
    {
      "type": "service",
      "pattern": "Service",
      "color": "#84CC16",
      "icon": "⚙️",
      "description": "Application service orchestrating use cases"
    }
  ],
  "validationRules": [
    {
      "rule": "DIP_VIOLATION",
      "type": "prohibited",
      "description": "Domain components cannot depend on infrastructure components (Dependency Inversion Principle)",
      "pattern": "usecase->adapter|entity->adapter|port->adapter"
    },
    {
      "rule": "BOUNDED_CONTEXT_VIOLATION",
      "type": "prohibited",
      "description": "Entities from one module cannot be directly used by another module",
      "pattern": "module.entity->other_module.*"
    },
    {
      "rule": "AGGREGATE_INTEGRITY",
      "type": "required",
      "description": "Each entity must belong to exactly one aggregate root",
      "pattern": "entity->aggregate_root"
    },
    {
      "rule": "PORT_IMPLEMENTATION",
      "type": "required",
      "description": "Each port must be implemented by at least one adapter",
      "pattern": "port<-adapter"
    },
    {
      "rule": "USE_CASE_ISOLATION",
      "type": "required",
      "description": "Use cases should only depend on ports, not concrete adapters",
      "pattern": "usecase->port"
    },
    {
      "rule": "MODULE_COMPLETENESS",
      "type": "required",
      "description": "Each module must define at least one use case",
      "pattern": "module->usecase"
    },
    {
      "rule": "HANDLER_DELEGATION",
      "type": "required",
      "description": "HTTP handlers should delegate to use cases, not contain business logic",
      "pattern": "handler->usecase"
    },
    {
      "rule": "EVENT_DECOUPLING",
      "type": "required",
      "description": "Domain events should be used for cross-module communication",
      "pattern": "module->event->other_module"
    }
  ],
  "connector": {
    "type": "file-based",
    "parser": "go-ast",
    "fileWatcher": {
      "patterns": ["app/**/*.php"],
      "excludes": ["**/tests/**", "**/vendor/**"],
      "events": ["codeChanged", "codeApplied", "codeError"]
    },
    "analysis": {
      "graphCommand": "php artisan khex:graph --format=json --output=/tmp/laravel.graph.json",
      "outputPath": "/tmp/laravel.graph.json",
      "structureCommand": "php artisan khex:analyze --structure",
      "validationCommand": "php artisan khex:validate"
    },
    "paths": {
      "projectRoot": ".",
      "backendPath": "app",
      "tempDir": "/tmp"
    },
    "scgMapping": {
      "nodePositioning": {
        "module": {
          "baseX": 0,
          "baseY": 0
        },
        "usecase": {
          "baseX": 50,
          "baseY": 100
        },
        "adapter": {
          "baseX": 200,
          "baseY": 100
        },
        "entity": {
          "baseX": 100,
          "baseY": 200
        },
        "port": {
          "baseX": 150,
          "baseY": 50
        }
      },
      "componentTypes": {
        "usecase": "domain",
        "entity": "domain",
        "port": "domain",
        "adapter": "infrastructure",
        "handler": "infrastructure",
        "service": "application"
      }
    }
  },
  "cli": {
    "binary": "laravel",
    "checkCommand": "laravel --version",
    "operations": {
      "new": {
        "command": "laravel new {name}",
        "description": "Create a new Laravel project",
        "requiresProject": false
      },
      "khex:make:module": {
        "command": "php artisan khex:make:module {name}",
        "description": "Generate a new module",
        "requiresProject": true
      },
      "khex:graph": {
        "command": "php artisan khex:graph --format=json --output=/tmp/laravel.graph.json",
        "description": "Generate architecture graph",
        "requiresProject": true,
        "outputFile": "/tmp/laravel.graph.json"
      },
      "khex:analyze": {
        "command": "php artisan khex:analyze --structure",
        "description": "Analyze project structure",
        "requiresProject": true
      },
      "khex:validate": {
        "command": "php artisan khex:validate",
        "description": "Validate architecture rules",
        "requiresProject": true
      }
    }
  },
  "universalTagSystem": {
    "detection": {
      "filePatterns": [],
      "codePatterns": [],
      "directoryPatterns": []
    },
    "extraction": {
      "nativePatterns": {},
      "conventions": {
        "directoryMapping": {},
        "fileNamePatterns": {},
        "classNamePatterns": {}
      }
    },
    "translation": {
      "toSCG": {},
      "fromSCG": {}
    },
    "autoTagging": {
      "enabled": false,
      "confidence": "low",
      "patterns": []
    }
  },
  "metadata": {
    "framework": "laravel",
    "language": "php",
    "architecture": "hexagonal",
    "paradigm": "ddd",
    "principles": ["SOLID", "DDD", "Hexagonal", "Clean Architecture"],
    "filePatterns": {
      "modules": "app/Modules/*.php",
      "handlers": "app/Http/Controllers/*.php",
      "services": "app/Services/*.php",
      "entities": "app/Models/*.php",
      "ports": "app/Contracts/*.php"
    },
    "semanticMapping": {
      "Module": "lar:Module",
      "UseCase": "lar:UseCase",
      "Adapter": "lar:Adapter",
      "Port": "lar:Port",
      "Entity": "lar:Entity",
      "Event": "lar:Event"
    },
    "ontologyNamespace": "http://laravel.io/ontology#",
    "supportedFormats": ["json", "dot", "yaml", "rdf", "owl"]
  }
}
