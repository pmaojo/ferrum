{
  "id": "tuetano-hexagonal",
  "name": "Tuetano Hexagonal Architecture",
  "description": "Template for Tuetano projects using hexagonal architecture and DDD principles",
  "extends": "base-hexagonal",
  "nodeTypes": [
    {
      "type": "module",
      "pattern": "Module",
      "color": "#3B82F6",
      "icon": "📦",
      "description": "Tuetano module containing use cases, adapters, and entities"
    },
    {
      "type": "usecase",
      "pattern": "UseCase",
      "color": "#10B981",
      "icon": "⚡",
      "description": "Domain use case implementing business logic"
    },
    {
      "type": "adapter",
      "pattern": "Adapter",
      "color": "#F59E0B",
      "icon": "🔌",
      "description": "Infrastructure adapter implementing ports"
    },
    {
      "type": "port",
      "pattern": "Port",
      "color": "#8B5CF6",
      "icon": "🚪",
      "description": "Interface defining contract between domain and infrastructure"
    },
    {
      "type": "entity",
      "pattern": "Entity",
      "color": "#EF4444",
      "icon": "🏛️",
      "description": "Domain entity representing business concepts"
    },
    {
      "type": "event",
      "pattern": "Event",
      "color": "#F97316",
      "icon": "📡",
      "description": "Domain event for decoupled communication"
    },
    {
      "type": "handler",
      "pattern": "Handler",
      "color": "#06B6D4",
      "icon": "🎯",
      "description": "HTTP handler for API endpoints"
    },
    {
      "type": "service",
      "pattern": "Service",
      "color": "#84CC16",
      "icon": "⚙️",
      "description": "Application service orchestrating use cases"
    }
  ],
  "validationRules": [
    {
      "rule": "DIP_VIOLATION",
      "type": "prohibited",
      "description": "Domain components cannot depend on infrastructure components (Dependency Inversion Principle)",
      "pattern": "usecase->adapter|entity->adapter|port->adapter"
    },
    {
      "rule": "BOUNDED_CONTEXT_VIOLATION",
      "type": "prohibited",
      "description": "Entities from one module cannot be directly used by another module",
      "pattern": "module.entity->other_module.*"
    },
    {
      "rule": "AGGREGATE_INTEGRITY",
      "type": "required",
      "description": "Each entity must belong to exactly one aggregate root",
      "pattern": "entity->aggregate_root"
    },
    {
      "rule": "PORT_IMPLEMENTATION",
      "type": "required",
      "description": "Each port must be implemented by at least one adapter",
      "pattern": "port<-adapter"
    },
    {
      "rule": "USE_CASE_ISOLATION",
      "type": "required",
      "description": "Use cases should only depend on ports, not concrete adapters",
      "pattern": "usecase->port"
    },
    {
      "rule": "MODULE_COMPLETENESS",
      "type": "required",
      "description": "Each module must define at least one use case",
      "pattern": "module->usecase"
    },
    {
      "rule": "HANDLER_DELEGATION",
      "type": "required",
      "description": "HTTP handlers should delegate to use cases, not contain business logic",
      "pattern": "handler->usecase"
    },
    {
      "rule": "EVENT_DECOUPLING",
      "type": "required",
      "description": "Domain events should be used for cross-module communication",
      "pattern": "module->event->other_module"
    }
  ],
  "connector": {
    "type": "file-based",
    "parser": "clangd",
    "fileWatcher": {
      "patterns": ["src/**/*.cpp", "include/**/*.h", "include/**/*.hpp"],
      "excludes": ["**/tests/**", "**/build/**"],
      "events": ["codeChanged", "codeApplied", "codeError"]
    },
    "analysis": {
      "graphCommand": "tue tooling graph --format=json --output=/tmp/tuetano.graph.json",
      "outputPath": "/tmp/tuetano.graph.json",
      "structureCommand": "tue tooling graph --format=json",
      "validationCommand": "tue test"
    },
    "paths": {
      "projectRoot": ".",
      "backendPath": "src",
      "cliPath": ".",
      "tempDir": "/tmp"
    },
    "scgMapping": {
      "nodePositioning": {
        "module": { "baseX": 0, "baseY": 0 },
        "usecase": { "baseX": 50, "baseY": 100 },
        "adapter": { "baseX": 200, "baseY": 100 },
        "entity": { "baseX": 100, "baseY": 200 },
        "port": { "baseX": 150, "baseY": 50 }
      },
      "componentTypes": {
        "usecase": "domain",
        "entity": "domain",
        "port": "domain",
        "adapter": "infrastructure",
        "handler": "infrastructure",
        "service": "application"
      }
    }
  },
  "cli": {
    "binary": "tue",
    "operations": {
      "new": {
        "command": "tue scaffold new {name} --pkg {pkg}",
        "description": "Create a new Tuetano project",
        "requiresProject": false
      },
      "add:usecase": {
        "command": "tue scaffold add usecase {name}",
        "description": "Add a new use case",
        "requiresProject": true
      },
      "add:port": {
        "command": "tue scaffold add port {name} --type {type}",
        "description": "Add a new port",
        "requiresProject": true
      },
      "add:adapter": {
        "command": "tue scaffold add adapter {name} --kind {kind}",
        "description": "Add a new adapter",
        "requiresProject": true
      },
      "deps:install": {
        "command": "tue deps install",
        "description": "Install dependencies",
        "requiresProject": true
      },
      "build": {
        "command": "tue build",
        "description": "Build the project",
        "requiresProject": true
      },
      "test": {
        "command": "tue test",
        "description": "Run tests",
        "requiresProject": true
      }
    }
  },
  "universalTagSystem": {
    "detection": {
      "filePatterns": [],
      "codePatterns": [],
      "directoryPatterns": []
    },
    "extraction": {
      "nativePatterns": {},
      "conventions": {
        "directoryMapping": {},
        "fileNamePatterns": {},
        "classNamePatterns": {}
      }
    },
    "translation": {
      "toSCG": {},
      "fromSCG": {}
    },
    "autoTagging": {
      "enabled": false,
      "confidence": "low",
      "patterns": []
    }
  },
  "metadata": {
    "framework": "tuetano",
    "language": "cpp",
    "architecture": "hexagonal",
    "paradigm": "ddd",
    "principles": ["SOLID", "DDD", "Hexagonal", "Clean Architecture"],
    "cli": {
      "planGraph": "tue tooling graph --format=json --output=/tmp/tuetano.graph.json",
      "validate": "tue test"
    },
    "filePatterns": {
      "modules": "src/modules/*.cpp",
      "handlers": "src/infrastructure/**/*.cpp",
      "services": "src/application/**/*.cpp",
      "entities": "src/domain/**/*.cpp",
      "ports": "include/domain/*.h"
    },
    "semanticMapping": {
      "Module": "tue:Module",
      "UseCase": "tue:UseCase",
      "Adapter": "tue:Adapter",
      "Port": "tue:Port",
      "Entity": "tue:DomainEntity",
      "Event": "tue:DomainEvent"
    },
    "ontologyNamespace": "http://tuetano.dev/ontology#",
    "supportedFormats": ["json", "dot", "yaml", "rdf", "owl"]
  }
}
