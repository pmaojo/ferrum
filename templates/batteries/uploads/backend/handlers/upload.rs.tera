use axum::extract::Multipart;
use axum::http::StatusCode;
use axum::response::IntoResponse;
use tokio::fs;
use uuid::Uuid;

/// Handle multipart file uploads by saving each file to `./uploads`.
pub async fn upload(mut multipart: Multipart) -> impl IntoResponse {
    while let Some(field) = multipart.next_field().await.unwrap() {
        if let Some(filename) = field.file_name() {
            if let Ok(data) = field.bytes().await {
                // Best effort create uploads directory
                let _ = fs::create_dir_all("./uploads").await;
                let path = format!("./uploads/{}_{}", Uuid::new_v4(), filename);
                if fs::write(&path, &data).await.is_err() {
                    eprintln!("failed to save uploaded file: {}", path);
                    return StatusCode::INTERNAL_SERVER_ERROR;
                }
            }
        }
    }

    StatusCode::OK
}
