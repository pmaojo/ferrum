use axum::{extract::{Extension, Json, Path}, http::StatusCode};
{% if entity %}use diesel::prelude::*;
{% endif %}use uuid::Uuid;

use crate::db::DbPool;
{% if entity %}use crate::db::models::{{ entity.struct_name }};
use crate::db::schema::{{ entity.table_name }}::dsl::*;
{% endif %}{% set_global validated = false %}{% for uc in usecases %}{% if uc.field_validations | length > 0 %}{% set_global validated = true %}{% endif %}{% endfor %}{% if validated %}use crate::validations::*;
{% endif %}
{% for uc in usecases %}
#[allow(non_snake_case)]
pub async fn {{ uc.id }}_handler(
    Extension(pool): Extension<DbPool>,
{% if uc.takes_id %}    Path(_item_id): Path<Uuid>,
{% endif %}{% if uc.takes_body %}    Json({% if uc.field_validations | length > 0 %}payload{% else %}_payload{% endif %}): Json<serde_json::Value>,
{% endif %}) -> Result<Json<serde_json::Value>, StatusCode> {
    let mut _conn = pool.get().map_err(|_| StatusCode::SERVICE_UNAVAILABLE)?;
{% for v in uc.field_validations %}    if !{{ v.func }}(payload["{{ v.field }}"].as_str().unwrap_or("")) {
        return Err(StatusCode::BAD_REQUEST);
    }
{% endfor %}    // vord:hole usecase-{{ uc.id | kebab_case }}
    // ⛳ AI_FILL[usecase_logic] --context=usecase:{{ uc.id }}
{% if entity and uc.kind == "list" %}    let rows = {{ entity.table_name }}
        .load::<{{ entity.struct_name }}>(&mut _conn)
        .map_err(|_| StatusCode::INTERNAL_SERVER_ERROR)?;
    Ok(Json(serde_json::to_value(rows).map_err(|_| StatusCode::INTERNAL_SERVER_ERROR)?))
{% else %}    Err(StatusCode::NOT_IMPLEMENTED)
{% endif %}    // vord:end-hole
}
{% endfor %}
