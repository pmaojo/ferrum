import React from 'react';
import { use{{ hook_name }} } from '../../hooks/use{{ hook_name }}';
{% if policy_hook_name %}import { use{{ policy_hook_name }} } from '../../hooks/use{{ policy_hook_name }}';
{% endif %}
import { z } from 'zod';

const schema = z.object({
{% for field in node.input %}  {{ field.name }}: z.string(),
{% endfor %}});

type FormData = z.infer<typeof schema>;

export const {{ node.id | capitalize }}: React.FC = () => {
  const { mutate } = use{{ hook_name }}();
{% if policy_hook_name %}  const allowed = use{{ policy_hook_name }}();
  if (!allowed) return null;
{% endif %}  const [values, setValues] = React.useState<FormData>({
{% for field in node.input %}    {{ field.name }}: '',
{% endfor %}  });

  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    setValues({ ...values, [e.target.name]: e.target.value });
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    const res = schema.safeParse(values);
    if (!res.success) { console.error(res.error); return; }
    mutate(values);
  };

  return (
    <form onSubmit={handleSubmit}>
{% for field in node.input %}      <input name="{{ field.name }}" value={values.{{ field.name }}} onChange={handleChange} placeholder="{{ field.name }}" />
{% endfor %}      <button type="submit">Submit</button>
    </form>
  );
};
